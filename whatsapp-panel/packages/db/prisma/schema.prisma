generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum AdminRole { OWNER ADMIN SUPPORT }
enum InventoryStatus { AVAILABLE RESERVED SOLD BLOCKED EXPIRED }
enum OrderStatus { PENDING PAID DELIVERED CANCELLED FAILED }
enum RechargeStatus { PENDING PAID CREDITED CANCELLED EXPIRED }
enum CustomerStatus { ACTIVE BLOCKED }
enum ConnectionStatus { DISCONNECTED CONNECTING QR_READY CONNECTED ERROR }

model Admin { id String @id @default(uuid()) email String @unique passwordHash String role AdminRole @default(SUPPORT) active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt auditLogs AdminAuditLog[] walletEntries WalletLedger[] }
model WhatsAppSession { id String @id @default("primary") status ConnectionStatus @default(DISCONNECTED) jid String? displayName String? deviceName String? connectedAt DateTime? lastSeenAt DateTime? lastError String? updatedAt DateTime @updatedAt }
model BotSetting { key String @id value Json updatedAt DateTime @updatedAt }
model BotCommand { id String @id @default(uuid()) name String @unique description String @default("") response String permission String @default("PUBLIC") enabled Boolean @default(true) sortOrder Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model BotFlow { id String @id @default(uuid()) name String enabled Boolean @default(false) definition Json createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Customer { id String @id @default(uuid()) jid String @unique phone String? name String? balanceCents Int @default(0) status CustomerStatus @default(ACTIVE) notes String? lastInteractionAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt orders Order[] recharges Recharge[] walletEntries WalletLedger[] events ConversationEvent[] }
model Product { id String @id @default(uuid()) sku String @unique name String category String @default("General") description String @default("") priceCents Int currency String @default("PEN") active Boolean @default(true) minimumStock Int @default(2) whatsappText String @default("") imageUrl String? sortOrder Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt inventory InventoryItem[] orders Order[] @@index([active,sortOrder]) }
model InventoryItem { id String @id @default(uuid()) productId String product Product @relation(fields:[productId],references:[id],onDelete:Restrict) deliveryIdentifier String encryptedSecret String status InventoryStatus @default(AVAILABLE) expiresAt DateTime? reservedAt DateTime? soldAt DateTime? order Order? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([productId,status]) }
model Order { id String @id @default(uuid()) customerId String customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict) productId String product Product @relation(fields:[productId],references:[id],onDelete:Restrict) inventoryItemId String? @unique inventoryItem InventoryItem? @relation(fields:[inventoryItemId],references:[id],onDelete:SetNull) priceCents Int currency String @default("PEN") status OrderStatus @default(PENDING) idempotencyKey String @unique deliveryAt DateTime? error String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([customerId,createdAt]) @@index([status,createdAt]) }
model WalletLedger { id String @id @default(uuid()) customerId String customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict) previousCents Int deltaCents Int resultingCents Int reason String reference String? adminId String? admin Admin? @relation(fields:[adminId],references:[id],onDelete:SetNull) createdAt DateTime @default(now()) @@index([customerId,createdAt]) }
model Recharge { id String @id @default(uuid()) customerId String customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict) amountCents Int currency String @default("PEN") status RechargeStatus @default(PENDING) provider String @default("MANUAL") providerReference String? @unique note String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([status,createdAt]) }
model ConversationEvent { id String @id @default(uuid()) customerId String? customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull) direction String eventType String command String? contentPreview String? orderId String? rechargeId String? error String? createdAt DateTime @default(now()) @@index([customerId,createdAt]) @@index([createdAt]) }
model BotEvent { id String @id @default(uuid()) level String type String message String metadata Json? createdAt DateTime @default(now()) @@index([level,createdAt]) }
model AdminAuditLog { id String @id @default(uuid()) adminId String? admin Admin? @relation(fields:[adminId],references:[id],onDelete:SetNull) action String entity String entityId String? ipHash String? metadata Json? createdAt DateTime @default(now()) @@index([createdAt]) }
