# Django
SECRET_KEY=change-me-to-a-long-random-string
# Alternativa para Docker Secrets: SECRET_KEY_FILE=/run/secrets/django_secret_key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,jheliztv.xyz,www.jheliztv.xyz

# Base URL
SITE_URL=http://127.0.0.1:8000

# Database (SQLite for local dev, Postgres for prod)
DATABASE_URL=sqlite:///db.sqlite3
# Alternativa para Docker Secrets: DATABASE_URL_FILE=/run/secrets/database_url

# Backup diario cifrado de JHELIZCONTROLTV + bot a MEGA.
# Guarda BACKUP_ARCHIVE_PASSWORD también fuera del VPS: es necesaria al restaurar.
MEGA_EMAIL=backups@example.com
MEGA_PASSWORD=cambiar
MEGA_FOLDER=/JhelizControlBackups
BACKUP_DAILY_KEEP_DAYS=30
BACKUP_MONTHLY_KEEP_MONTHS=12
BACKUP_NAME_PREFIX=jheliz-control
BACKUP_CRON_SCHEDULE=20 3 * * *
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
BACKUP_NOTIFY_SUCCESS=true
BACKUP_ARCHIVE_PASSWORD=cambiar-por-frase-larga-y-unica

# Email (use console backend in dev, SMTP en prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para producción con SMTP (ej. Brevo/SendGrid/Hostinger):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Jheliz <no-reply@jheliztv.xyz>
SUPPORT_ADMIN_EMAIL=admin@jheliztv.xyz

# Mercado Pago (Perú)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# Para ocultar MP del checkout sin perder credenciales (la herramienta de
# diagnóstico /panel-jheliz-control/mp-diagnose/ sigue funcionando):
MERCADOPAGO_CHECKOUT_ENABLED=True

# Web Push (PWA notifications). Generá las claves con:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); v.save_key('vapid_private.pem'); print('PUBLIC:', v.public_key.hex())"
# La pública se publica en /cuenta/push/config/ para que el navegador la use.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:soporte@jheliztv.xyz

# Contact / Social
WHATSAPP_NUMBER=+51999999999
TELEGRAM_USERNAME=jhelizbot

# Bot de Telegram (opcional)
# Token desde @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Tu chat_id numérico para recibir notificaciones de pedidos nuevos
# (obtenlo con @userinfobot en Telegram)
TELEGRAM_ADMIN_CHAT_ID=
# Token random para validar el webhook de Telegram (path + header).
# Genéralo con: python -c 'import secrets;print(secrets.token_urlsafe(32))'
TELEGRAM_WEBHOOK_SECRET=
# Canal público de DISTRIBUIDORES (precios mayoristas, alertas técnicas).
# Puede ser @username o un ID numérico. Vacío = desactivado.
TELEGRAM_CHANNEL_ID=
# Canal público de CLIENTES FINALES (precios cliente, promos, restocks).
# Puede ser @username o un ID numérico. Vacío = desactivado.
TELEGRAM_CUSTOMER_CHANNEL_ID=

# Bot de CÓDIGOS de Netflix (opcional, app `codes`)
# Bot separado: los clientes piden el código de Netflix de las cuentas que
# el admin les asignó. Token desde @BotFather.
TELEGRAM_CODES_BOT_TOKEN=
# Alternativa: TELEGRAM_CODES_BOT_TOKEN_FILE=/run/secrets/telegram_codes_bot_token
JHELIZ_CONTROL_TELEGRAM_BOT_TOKEN=
JHELIZ_CONTROL_TELEGRAM_BOT_USERNAME=JHELIZCONTROLTV_bot
JHELIZ_CONTROL_BASE_URL=https://jheliztv.xyz
# Chat id del admin del bot de códigos (recibe aviso de altas nuevas).
TELEGRAM_CODES_ADMIN_CHAT_ID=
# Emojis Premium opcionales. Envía un emoji al bot y responde con /emojiid
# desde el chat administrador para obtener cada ID.
CODES_PREMIUM_EMOJI_KEY_ID=
CODES_PREMIUM_EMOJI_TRAVEL_ID=
CODES_PREMIUM_EMOJI_HOME_ID=
CODES_PREMIUM_EMOJI_LOCK_ID=
CODES_PREMIUM_EMOJI_TV_ID=
CODES_PREMIUM_EMOJI_MAIL_ID=
CODES_PREMIUM_EMOJI_SUCCESS_ID=
CODES_PREMIUM_EMOJI_WARNING_ID=
CODES_PREMIUM_EMOJI_SPARKLES_ID=
CODES_PREMIUM_EMOJI_HELP_ID=
CODES_PREMIUM_EMOJI_CLIENTS_ID=
CODES_PREMIUM_EMOJI_ACTIVATE_ID=
CODES_PREMIUM_EMOJI_DEACTIVATE_ID=
CODES_PREMIUM_EMOJI_ASSIGN_ID=
CODES_PREMIUM_EMOJI_REMOVE_ID=
CODES_PREMIUM_EMOJI_ANNOUNCEMENT_ID=
CODES_PREMIUM_EMOJI_SEARCH_ID=
CODES_PREMIUM_EMOJI_TV_LINK_ID=
# Casilla corporativa de Proton Mail conectada por Bridge local.
CODES_IMAP_HOST=proton-bridge.internal
CODES_IMAP_PORT=1143
CODES_IMAP_USER=codigosjheliz@protonmail.com
CODES_IMAP_SECURITY=STARTTLS
CODES_IMAP_TLS_VERIFY=false
# Contraseña IMAP generada por Bridge (NO la contraseña de Proton).
CODES_IMAP_PASSWORD=
# Alternativa: CODES_IMAP_PASSWORD_FILE=/run/secrets/codes_imap_password
# Segunda casilla opcional. Vacío = solo se usa la casilla corporativa.
CODES_IMAP2_HOST=
CODES_IMAP2_PORT=993
CODES_IMAP2_USER=
CODES_IMAP2_PASSWORD=
CODES_IMAP2_SECURITY=SSL
CODES_IMAP2_TLS_VERIFY=true
# Identidad interna/lectura y remitente saliente, respectivamente.
SYSTEM_EMAIL_ACCOUNT=codigosjheliz@protonmail.com
OUTBOUND_FROM_EMAIL=corp@jhelizstore.xyz
EMAIL_BACKEND=config.corporate_email_backend.CorporateSMTPEmailBackend
EMAIL_HOST=proton-bridge.internal
EMAIL_PORT=1025
EMAIL_HOST_USER=corp@jhelizstore.xyz
EMAIL_HOST_PASSWORD=
# Alternativa: EMAIL_HOST_PASSWORD_FILE=/run/secrets/corporate_mail_bridge_password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Jheliz <corp@jhelizstore.xyz>
# Alternativa: CODES_IMAP2_PASSWORD_FILE=/run/secrets/codes_imap2_password
# Minutos hacia atrás para considerar vigente un correo de Netflix.
CODES_LOOKBACK_MINUTES=15
CODES_IMAP_MAX_SCAN=100
CODES_MONITOR_INTERVAL_SECONDS=300
# Máximo de pedidos de código por cliente por día (0 = sin límite)
CODES_DAILY_LIMIT=20
# Elimina de Telegram códigos y enlaces después de 10 minutos (0 = desactivar).
CODES_SENSITIVE_MESSAGE_TTL_SECONDS=600
# Bloqueo de 15 minutos tras 3 intentos sobre cuentas no asignadas.
CODES_FOREIGN_ATTEMPT_LIMIT=3
CODES_SECURITY_BLOCK_SECONDS=900
# Ruta de la imagen de banner que el bot manda en /start (vacío = sin banner)
# CODES_BOT_BANNER=

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Cifrado de credenciales entregadas (Fernet). Generar UNA vez con:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# y guardarla en un gestor de secretos. Si la pierdes, NO podrás descifrar
# las credenciales ya guardadas.
FIELD_ENCRYPTION_KEY=
# Alternativa: FIELD_ENCRYPTION_KEY_FILE=/run/secrets/field_encryption_key

# django-axes: cuántos intentos fallidos antes de bloquear (por IP+usuario)
# y cuántas horas dura el bloqueo. Defaults razonables: 10 intentos / 1h.
# Acepta decimales: AXES_COOLOFF_TIME_HOURS=0.5 = 30 min.
# Para desbloquear a un usuario que se quedó fuera:
#   python manage.py unlock_logins --user <email>
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME_HOURS=1.0
# Redes desde las que Django acepta X-Real-IP (Nginx/Docker internos únicamente).
TRUSTED_PROXY_NETWORKS=127.0.0.0/8,::1/128,172.16.0.0/12

# Notificaciones cuando alguien inicia sesión en el admin (email + Telegram).
# Se envían a SUPPORT_ADMIN_EMAIL y al TELEGRAM_ADMIN_CHAT_ID.
ADMIN_LOGIN_NOTIFY=True
# Alertas por email/Telegram ante cambios de contraseña, privilegios y 2FA.
SECURITY_EVENT_ALERTS=True

# 2FA en el admin. Déjalo en False hasta que registres tu dispositivo TOTP
# en /panel-jheliz-control/otp_totp/totpdevice/. Activarlo bloquea el admin a quien
# no tenga 2FA confirmado.
ADMIN_2FA_ENFORCED=False
# Actívalo en producción inmediatamente DESPUÉS de registrar y confirmar el
# primer dispositivo desde /panel-jheliz-control/security/2fa/.

# ---------------------------------------------------------------------------
# Discord bot (back-office)
# ---------------------------------------------------------------------------
# Bot que reemplaza a Telegram para el manejo de pedidos, Yape, codigos y
# distribuidores. Telegram queda solo para el canal publico de anuncios.
#
# Setup:
#   1) Crear bot en https://discord.com/developers/applications -> Bot -> Reset Token
#   2) Invitar al servidor con scope `bot + applications.commands` y permiso 8 (admin).
#   3) Activar Modo desarrollador en Discord y copiar el ID del servidor.
#   4) Correr `python manage.py discord_setup --guild <ID>` y pegar el snippet.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_PEDIDOS=
DISCORD_CHANNEL_YAPE=
DISCORD_CHANNEL_CODIGOS=
DISCORD_CHANNEL_ALERTAS=
DISCORD_CHANNEL_ADMIN=
# Para slash commands (`/buscar`, `/pendientes`, `/entregar`, `/stock`):
#   - DISCORD_PUBLIC_KEY: Developer Portal → General Information → "Public Key"
#   - DISCORD_APPLICATION_ID: misma página, "Application ID"
#   - Después corré `python manage.py discord_register_commands` para registrarlos
#   - Configurar "Interactions Endpoint URL" =
#       https://jheliztv.xyz/discord/interactions/
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Directorio que Nginx publica como /static/. En desarrollo puede omitirse.
STATICFILES_DIR=/srv/jheliz/staticfiles
