DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
ACCOUNT_CREDENTIAL_KEY=generate-a-fernet-key-before-saving-credentials

# PostgreSQL is optional during local development. Without POSTGRES_HOST,
# Django uses an isolated local SQLite database.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=jheliz_digital
POSTGRES_USER=jheliz_digital
POSTGRES_PASSWORD=
